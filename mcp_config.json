{
  "mcpServers": {
    "slm": {
      "command": "<project-root>\\.venv\\Scripts\\slm.exe",
      "args": ["mcp"],
      "env": {
        "PYTHONPATH": "<project-root>",
        "SLM_DISABLE_WARMUP_SIDE_EFFECTS": "1"
      },
      "timeout": 30,
      "enabled": true
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {},
      "timeout": 60,
      "enabled": true
    },
    "fetch": {
      "command": "<project-root>\\.venv\\Scripts\\python.exe",
      "args": ["-m", "mcp_server_fetch"],
      "env": {},
      "timeout": 30,
      "enabled": true
    },
    "kg-mem": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "<project-root>\\mcp-servers\\kg-mem\\memory.json"
      },
      "timeout": 30,
      "enabled": true
    },
    "github": {
      "command": "cmd",
      "args": ["/c", "<project-root>\\scripts\\run_github_mcp.bat"],
      "env": {},
      "timeout": 30,
      "enabled": true
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@executeautomation/playwright-mcp-server"],
      "env": {},
      "timeout": 60,
      "enabled": true
    }
  }
}
