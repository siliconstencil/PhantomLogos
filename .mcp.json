{
  "mcpServers": {
    "slm": {
      "args": [
        "mcp"
      ],
      "command": "<project-root>\\.venv\\Scripts\\slm.exe",
      "env": {
        "PYTHONPATH": "<project-root>",
        "SLM_DISABLE_WARMUP_SIDE_EFFECTS": "1"
      }
    },
    "sequential-thinking": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "cmd",
      "env": {}
    },
    "fetch": {
      "args": [
        "-m",
        "mcp_server_fetch"
      ],
      "command": "<project-root>\\.venv\\Scripts\\python.exe",
      "env": {
        "PYTHONPATH": "<project-root>"
      }
    },
    "kg-mem": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "cmd",
      "env": {
        "MEMORY_FILE_PATH": "<project-root>\\mcp-servers\\kg-mem\\memory.json",
        "PYTHONPATH": "<project-root>"
      }
    },
    "github": {
      "args": [
        "/c",
        "<project-root>\\scripts\\run_github_mcp.bat"
      ],
      "command": "cmd",
      "env": {
        "PYTHONPATH": "<project-root>"
      }
    },
    "playwright": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "command": "cmd",
      "env": {
        "PYTHONPATH": "<project-root>"
      }
    }
  }
}
