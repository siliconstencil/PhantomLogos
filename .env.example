# Phantom Logos environment template.
# Copy to .env and adjust: cp .env.example .env
# Every variable below is read by the code. Nothing here is required: the
# defaults in the source are used when a variable is absent.

# --- Local inference (Ollama) ---
# Ollama serves the local models. The core needs it for chat and embeddings.
OLLAMA_HOST=http://127.0.0.1:11434
# The gateway client prefers this name; keep both pointing at the same server.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Optional SuperLocalMemory daemon (full memory mode) ---
# SLM is optional. With SLM_ENABLED=false the system uses LanceDB + Ollama.
# The daemon is reached over HTTP, never as an MCP stdio server.
SLM_ENABLED=false
SLM_HTTP_PORT=8765
SLM_ENDPOINT=http://localhost:8765
# Path to the SLM executable, used to start the daemon out of process.
# SLM_BIN=.venv-slm/bin/slm

# --- Retrieval (RAG) ---
RAG_MAX_CHUNKS=20

# --- Token budget ---
# Per-tier context budgets used by the pruner.
TOKEN_ENCODING=cl100k_base
TOKEN_TIER_GLOBAL=5000
TOKEN_TIER_REASONING=3000
TOKEN_TIER_TASK=4000
# Above this token count the gateway prefers the local model.
CLOUD_TOKEN_THRESHOLD=4000

# --- Runtime timeouts ---
# Seconds a single graph node may run.
ORCHESTRATOR_NODE_TIMEOUT=180
# Seconds the gateway waits for the local fallback before giving up.
LOCAL_FALLBACK_TIMEOUT=180
# Secondary gateway probe timeout in seconds.
ANTIGRAVITY_GATEWAY_SECONDARY_TIMEOUT=2.0

# --- Hardware ---
# Usable VRAM in GB (total VRAM minus the OS reserve).
GPU_TOTAL_VRAM_GB=7.0
# Swap usage above this threshold triggers the VRAM sweeper.
VRAM_SWAP_THRESHOLD_GB=5.5
# Minimum free disk space in MB before the sweeper prunes.
MIN_DISK_FREE_MB=500

# --- Logging ---
LOG_LEVEL=INFO

# --- Optional local gateway proxy ---
# The system falls back to Ollama when this proxy is absent.
# ANTIGRAVITY_GATEWAY_URL=http://localhost:32553
# ANTIGRAVITY_GATEWAY_URL_SECONDARY=http://localhost:32554
