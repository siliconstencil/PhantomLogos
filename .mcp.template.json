{
  "mcpServers": {
    "sequential-thinking": {
      "args": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx",
      "env": {}
    },
    "fetch": {
      "args": [
        "-m",
        "mcp_server_fetch"
      ],
      "command": "${PHANTOM_ROOT}/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${PHANTOM_ROOT}"
      }
    },
    "kg-mem": {
      "args": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx",
      "env": {
        "MEMORY_FILE_PATH": "${PHANTOM_ROOT}/mcp-servers/kg-mem/memory.json",
        "PYTHONPATH": "${PHANTOM_ROOT}"
      }
    },
    "github": {
      "args": [
        "${PHANTOM_ROOT}/scripts/run_github_mcp.sh"
      ],
      "command": "bash",
      "env": {
        "PYTHONPATH": "${PHANTOM_ROOT}"
      }
    },
    "playwright": {
      "args": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "command": "npx",
      "env": {
        "PYTHONPATH": "${PHANTOM_ROOT}"
      }
    },
    "filesystem": {
      "args": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${PHANTOM_ROOT}"
      ],
      "command": "npx",
      "env": {
        "PYTHONPATH": "${PHANTOM_ROOT}"
      }
    }
  }
}
