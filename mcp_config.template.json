{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "timeout": 60,
      "enabled": true
    },
    "fetch": {
      "command": "${PHANTOM_ROOT}/.venv/bin/python",
      "args": [
        "-m",
        "mcp_server_fetch"
      ],
      "env": {},
      "timeout": 30,
      "enabled": true
    },
    "kg-mem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${PHANTOM_ROOT}/mcp-servers/kg-mem/memory.json"
      },
      "timeout": 30,
      "enabled": true
    },
    "github": {
      "command": "${PHANTOM_ROOT}/scripts/run_github_mcp.sh",
      "args": [],
      "env": {},
      "timeout": 30,
      "enabled": false
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "env": {},
      "timeout": 60,
      "enabled": true
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${PHANTOM_ROOT}"
      ],
      "env": {
        "PYTHONPATH": "${PHANTOM_ROOT}"
      },
      "timeout": 30,
      "enabled": true
    }
  }
}
